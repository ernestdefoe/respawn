{
    "name": "ernestdefoe/respawn",
    "description": "A gaming-styled theme for Flarum 2: chamfered surfaces, neon accents, mono typography, level badges, and a server-status stats footer.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "theme",
        "gaming",
        "dark",
        "neon"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/respawn",
    "support": {
        "forum": "https://discuss.flarum.org/d/39298-respawn",
        "issues": "https://github.com/ernestdefoe/respawn/issues",
        "source": "https://github.com/ernestdefoe/respawn"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Respawn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Respawn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Respawn — gaming theme",
            "category": "theme",
            "icon": {
                "name": "fa-solid fa-gamepad",
                "backgroundColor": "#0b0f14",
                "color": "#2af0ff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
